FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Heavy, rarely-changing QA runtime dependencies live in this cached base.
# scripts/build-release.sh fingerprints this file + requirements.txt and only
# rebuilds the base when that fingerprint changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg procps iproute2 tini \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-17 \
    && pg_dump --version \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/qa-runtime/requirements.txt
RUN pip install --no-cache-dir --upgrade pip wheel setuptools \
    && pip install --no-cache-dir -r /tmp/qa-runtime/requirements.txt \
    && python -m playwright install --with-deps chromium \
    && rm -rf /root/.cache/pip /var/lib/apt/lists/*
